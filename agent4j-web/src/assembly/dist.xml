<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.2.0 http://maven.apache.org/xsd/assembly-2.2.0.xsd">

    <id>dist</id>

    <formats>
        <format>tar.gz</format>
    </formats>

    <includeBaseDirectory>false</includeBaseDirectory>

    <!-- 包含 fat jar -->
    <files>
        <file>
            <source>${project.build.directory}/${project.build.finalName}.jar</source>
            <outputDirectory>bin</outputDirectory>
            <destName>agent4j-web.jar</destName>
            <fileMode>0644</fileMode>
        </file>
    </files>

    <!-- 包含脚本和配置 -->
    <fileSets>
        <!-- 安装脚本（根目录） -->
        <fileSet>
            <directory>src/dist</directory>
            <outputDirectory>.</outputDirectory>
            <includes>
                <include>install.ps1</include>
                <include>install.sh</include>
                <include>config.json</include>
                <include>agent4j.md</include>
            </includes>
            <fileMode>0644</fileMode>
        </fileSet>

        <!-- 安装脚本可执行权限 -->
        <fileSet>
            <directory>src/dist</directory>
            <outputDirectory>.</outputDirectory>
            <includes>
                <include>install.sh</include>
            </includes>
            <fileMode>0755</fileMode>
        </fileSet>

        <!-- 卸载脚本（bin 目录） -->
        <fileSet>
            <directory>src/dist/bin</directory>
            <outputDirectory>bin</outputDirectory>
            <includes>
                <include>uninstall.ps1</include>
                <include>uninstall.sh</include>
            </includes>
            <fileMode>0644</fileMode>
        </fileSet>

        <!-- 卸载脚本可执行权限 -->
        <fileSet>
            <directory>src/dist/bin</directory>
            <outputDirectory>bin</outputDirectory>
            <includes>
                <include>uninstall.sh</include>
            </includes>
            <fileMode>0755</fileMode>
        </fileSet>
    </fileSets>

</assembly>
