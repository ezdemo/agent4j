<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>site.sorghum.agent</groupId>
        <artifactId>loopra</artifactId>
        <version>26.8.40</version>
    </parent>

    <artifactId>loopra-model</artifactId>
    <description>Loopra 内核：ChatModel 客户端与协议、Agent 推理循环、工具基础抽象、会话/配置/Goal/Checklist/工作区</description>

    <dependencies>
        <!-- Solon AI 聊天模型 API（FunctionTool / ToolCall 等类型） -->
        <dependency>
            <groupId>org.noear</groupId>
            <artifactId>solon-ai</artifactId>
        </dependency>

        <!-- Solon IoC/AOP 容器 -->
        <dependency>
            <groupId>org.noear</groupId>
            <artifactId>solon-lib</artifactId>
        </dependency>

        <!-- JSON 解析（snack4 + jsonpath） -->
        <dependency>
            <groupId>org.noear</groupId>
            <artifactId>snack4</artifactId>
        </dependency>
        <dependency>
            <groupId>org.noear</groupId>
            <artifactId>snack4-jsonpath</artifactId>
        </dependency>

        <!-- OkHttp HTTP 客户端 -->
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp</artifactId>
            <version>${okhttp.version}</version>
        </dependency>

        <!-- Hugging Face tokenizer.json 的本地 BPE 计数器（含各平台 native 库） -->
        <dependency>
            <groupId>ai.djl.huggingface</groupId>
            <artifactId>tokenizers</artifactId>
            <version>0.28.0</version>
        </dependency>

        <!-- DamiBus 本地事件总线 -->
        <dependency>
            <groupId>org.noear</groupId>
            <artifactId>dami2</artifactId>
            <version>2.0.5</version>
        </dependency>

        <dependency>
            <groupId>org.jetbrains</groupId>
            <artifactId>annotations</artifactId>
            <version>13.0</version>
            <scope>compile</scope>
        </dependency>

        <!-- 日志实现由宿主应用提供（web/harness 显式引入），内核仅作 provided -->
        <dependency>
            <groupId>org.noear</groupId>
            <artifactId>solon-logging-logback</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.noear</groupId>
            <artifactId>solon-test-junit5</artifactId>
            <version>${solon.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
