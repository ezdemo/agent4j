{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-utils/schema.json",
  "productName": "Agent4j",
  "version": "2026.6.5",
  "identifier": "com.agent4j.desktop",
  "build": {
    "beforeDevCommand": "cd ../agent4j-front && pnpm dev",
    "beforeBuildCommand": "cd ../agent4j-front && pnpm build",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../../agent4j-front/dist"
  },
  "app": {
    "windows": [
      {
        "fullscreen": false,
        "resizable": true,
        "title": "Agent4j",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "transparent": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "externalBin": [],
    "icon": [
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/agent4j-web-dist.tar.gz"
    ],
    "shortDescription": "Agent4j Desktop",
    "targets": "all",
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    }
  }
}